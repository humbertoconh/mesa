# Supabase → botón Connect, o Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# platform.claude.com → Settings → API keys
# Sólo se usa en el servidor. Nunca la pongas con NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase → Project Settings → API Keys → secret (sb_secret_... o service_role)
# SÓLO servidor. Si esta se filtra, se salta toda la seguridad de la base.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Avisos por correo (opcional: sin esto la app va igual, pero sin avisos)
# resend.com → API Keys
RESEND_API_KEY=re_...
AVISOS_EMAIL=humbertoconh@gmail.com
# Dirección de envío. Con la de pruebas de Resend sólo se puede enviar
# a tu propio correo; para escribir a otros hay que verificar un dominio.
AVISOS_DESDE=Mesa <onboarding@resend.dev>
# Para que el enlace del correo apunte a la app
APP_URL=https://mesa-casa.vercel.app
